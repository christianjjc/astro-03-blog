---
import { Formatter } from '@utils/formatter';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { getEntry, getCollection } from 'astro:content';
import BlogLayout from 'src/layouts/BlogLayout.astro';

export const getStaticPaths = (async () => {
  const blogPosts = await getCollection('blog');

  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post: post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const frontmatter = post.data;

// console.log(post);

const { Content, headings } = await post.render();

const author = (await getEntry('author', post.data.author.id))!.data;
---

<BlogLayout title={frontmatter.title}>
  <h1>{frontmatter.title}</h1>
  <!-- <h4>{frontmatter.author}</h4> -->

  <div class="text-sm text-gray-400 flex flex-row my-5">
    <Image src={author.avatar} alt={author.name} height={50} width={50} class="rounded-full" />
    <div class="flex flex-col ml-5 justify-center">
      <a href=`/astro-03-blog/blog/${frontmatter.author.id}`>{author.name}</a>
      <span class="text-xs text-gray-200">
        {Formatter.formatDate(frontmatter.date)}
      </span>
    </div>
  </div>

  <Image
    class="object-cover w-full h-56 rounded-lg lg:w-64"
    src={frontmatter.image}
    alt={frontmatter.title}
    width={600}
    height={220}
    quality="low"
    loading="lazy"
    transition:name={`${post.slug}-image`}
  />

  <h3>Tabla de Contenidos</h3>

  <ol>
    {
      headings.map((heading, index) => (
        <li>
          <a href={`/astro-03-blog/#${heading.slug}`}>
            {index + 1} - {heading.text}
          </a>
        </li>
      ))
    }
  </ol>

  <Content />

  <div class="mt-20">
    <a href="/astro-03-blog/#btn-back">Ir arriba</a>
  </div>
</BlogLayout>

<style>
  @import '@styles/global.css';
  h1 {
    @apply text-3xl text-gray-500 mb-0;
  }
  h4 {
    @apply text-xl text-gray-400 mb-0;
  }
</style>
