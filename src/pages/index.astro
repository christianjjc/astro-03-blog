---
import { getCollection } from 'astro:content';
import { SiteConfig } from '../config/site-config';
import MainLayout from '../layouts/MainLayout.astro';
import TypedBlogPost from 'src/components/TypedBlogPost.astro';

const blogPosts = await getCollection(
  //
  'blog',
  (post) => post.data.isDraft === false,
);
---

<MainLayout title=`${SiteConfig.title}`>
  <section class="bg-white dark:bg-gray-900">
    <div class="container px-6 py-10 mx-auto">
      <h1 class="text-3xl font-semibold capitalize lg:text-4xl text-white">
        {SiteConfig.title}
      </h1>

      <div class="m-10 flex flex-col gap-5">
        <a class="text-blue-500 hover:underline" href="/astro-03-blog/blog/1">Blog Paginado</a>
        <a class="text-blue-500 hover:underline" href="/astro-03-blog/authors/">Authors</a>
      </div>

      <div class="grid grid-cols-1 gap-8 mt-8 md:mt-16 md:grid-cols-2">
        {blogPosts.map((p) => <TypedBlogPost post={p} />)}
      </div>
    </div>
  </section>
</MainLayout>
